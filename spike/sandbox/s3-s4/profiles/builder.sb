;; Shape builder: write repo/, shell + toolchain exec (offline).
(allow file-write* (subpath (string-append (param "STEP") "/repo")))
(allow file-read* (subpath "/usr/local/share/dotnet"))
(allow process-exec (subpath (param "PYROOT")) (literal "/bin/sh") (literal "/bin/bash") (literal "/usr/bin/env") (literal "/bin/sleep")
  (subpath "/usr/local/share/dotnet") (subpath (param "NODEROOT")))
(allow network-outbound (remote ip (string-append "localhost:" (param "PORT"))))
(allow file-read* (subpath "<work>/caches") (subpath "<work>/items/1/packages"))   ; shared caches + item overlay: read-only for every Step
